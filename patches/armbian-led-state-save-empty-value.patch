--- a/usr/lib/armbian/armbian-led-state-save.sh
+++ b/usr/lib/armbian/armbian-led-state-save.sh
@@ -54,6 +54,10 @@
 		# suppose it contains binary and skip it
 		[[ "$VALUE" =~ [[:cntrl:]] ]] && continue
 
+		# vektor: the pattern trigger reports an empty hr_pattern (or pattern);
+		# an empty value makes armbian-led-state-restore.sh exit 1 at boot.
+		[[ -z "$VALUE" ]] && continue
+
 		echo "$PARAM=$VALUE" >> $DESTINATION
 
 	done
